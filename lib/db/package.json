{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "check:published-migrations": "node test/published-migrations-checksum.test.mjs",
    "check:published-migrations:selftest": "node test/published-migrations-checksum-selftest.test.mjs",
    "test:db": "node test/orchestrate-db-tests.mjs",
    "test:db:write-evidence": "node test/orchestrate-db-tests.mjs --write-evidence",
    "test:db:orchestrator-selftest": "node test/orchestrator-failure-propagation.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
