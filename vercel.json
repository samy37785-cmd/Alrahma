{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @workspace/al-rahma-academy run build",
  "outputDirectory": "artifacts/al-rahma-academy/dist/public",
  "rewrites": [
    { "source": "^/api/v1/admin(/.*|)$", "destination": "/api/v1/admin-proxy?path=$1" },
    { "source": "/api/:path((?!v1/admin(?:$|/)).*)", "destination": "https://academy-backend-cxso.onrender.com/api/:path" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
