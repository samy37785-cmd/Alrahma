{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "corepack pnpm --filter @workspace/al-rahma-academy run build",
  "outputDirectory": "artifacts/al-rahma-academy/dist/public",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "rewrites": [
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
