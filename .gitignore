# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# secrets — never committed; real values live only in local .env files
.env
.env.*
!.env.example
!.env*.example

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Claude Code — local-only settings (personal permissions/config, never
# shared). Was previously excluded only via a personal global gitignore
# on one machine (invisible to any other clone/contributor/CI) — a real
# gap a review caught, since `git status`/`git add -A` would treat it as
# a normal untracked file anywhere else. `.claude/settings.json` (a
# project-level, intentionally SHARED config, if one is ever added) is
# deliberately NOT covered by this rule.
.claude/settings.local.json

# Stage 0 DB test-gate orchestrator — per-run transcripts (every
# orchestrate-db-tests.mjs invocation writes a full, timestamped log
# here; the curated, verified-green evidence file is
# lib/db/test/last-run-output.txt, which IS tracked).
lib/db/test/.run-logs/

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
